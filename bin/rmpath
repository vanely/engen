#!/bin/bash
# Remove a directory from PATH
# Usage: PATH=$(rmpath "/path/to/exclude")

PATH_TO_REMOVE="${1}"

if [[ -z "${PATH_TO_REMOVE}" ]]; then
  echo "Usage: rmpath \"/path/to/exclude\""
  echo ""
  echo "Outputs PATH without the specified directory."
  echo 'Set it: PATH=$(rmpath "/path/to/exclude")'
  exit 1
fi

# Check if the path exists in PATH
if ! echo "${PATH}" | tr ':' '\n' | grep -qxF "${PATH_TO_REMOVE}"; then
  echo "The directory \"${PATH_TO_REMOVE}\" is not in PATH" >&2
  echo "${PATH}"
  exit 1
fi

# Rebuild PATH without the specified directory
echo "${PATH}" | tr ':' '\n' | grep -vxF "${PATH_TO_REMOVE}" | paste -sd ':'
